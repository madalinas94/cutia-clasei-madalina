{
  "name": "Cutia Clasei",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [
    8000
  ],
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ]
    }
  },
  "postAttachCommand": "uvicorn src.app:app --host 0.0.0.0 --port 8000",
  "portsAttributes": {
    "8000": {
      "label": "Cutia Clasei",
      "onAutoForward": "openBrowser"
    }
  }
}
